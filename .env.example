# Copia questo file in .env e compila i valori dal pannello Supabase
# (Project Settings > API). La chiave anon e' pubblica per design: la
# sicurezza dei dati e' garantita dalle policy RLS lato database.
VITE_SUPABASE_URL=https://il-tuo-progetto.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-anon-key

# Captcha Cloudflare Turnstile su accesso, registrazione e "password dimenticata".
# In sviluppo la chiave di prova ufficiale di Cloudflare (passa sempre); in
# produzione la site key vera va nelle variabili d'ambiente di Vercel. Vuota =
# niente captcha (utile finché non è attivo anche in Supabase).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
